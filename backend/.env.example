# Fly Finder backend configuration.
# Copy this file to backend/.env and fill in the values. backend/.env is git-ignored.
# NEVER put these values in the Flutter app.

# --- General ---------------------------------------------------------------
# development | staging | production
ENVIRONMENT=development
# Working product name shown by the API (not a final brand).
APP_NAME=Fly Finder
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins. Mobile apps do not need CORS.
CORS_ORIGINS=http://localhost:3000

# --- Catalog storage --------------------------------------------------------
# memory   = read the curated CSV catalog in data/catalog (no database needed)
# postgres = use Supabase Postgres via DATABASE_URL
CATALOG_BACKEND=memory
# DEMO_MODE loads clearly-labelled fictional records and a fake AI analyzer so the
# app flows can be tested without API keys. Never enable in production.
DEMO_MODE=false

# --- Supabase ---------------------------------------------------------------
# Project URL: Settings -> Data API, or the "Connect" dialog (https://<ref>.supabase.co)
SUPABASE_URL=
# Settings -> API Keys -> "Secret keys" (sb_secret_...). Server-side only, bypasses RLS.
# A legacy service_role JWT also works, but Supabase deprecates legacy keys by end of 2026.
SUPABASE_SERVICE_ROLE_KEY=
# Project -> Connect -> "Session pooler" connection string (port 5432).
# Example shape: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
SUPABASE_STORAGE_BUCKET_CATALOG=catalog-images
SUPABASE_STORAGE_BUCKET_USER=user-uploads

# --- Gemini (Google AI Studio) ----------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Verified against https://ai.google.dev/gemini-api/docs/models on 2026-10-31.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45

# --- OpenCLIP embeddings ------------------------------------------------------
# Set to false to run without visual similarity (e.g. on small servers).
EMBEDDINGS_ENABLED=true
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
# cpu | mps | cuda
OPENCLIP_DEVICE=cpu

# --- External biodiversity APIs (no keys required) ---------------------------
GBIF_API_URL=https://api.gbif.org/v1
INATURALIST_API_URL=https://api.inaturalist.org/v1
# Identify the app to third-party APIs (required etiquette for iNaturalist/GBIF).
EXTERNAL_USER_AGENT=FlyFinder/0.1 (contact: set-your-email@example.com)

# --- Uploads and abuse protection --------------------------------------------
MAX_UPLOAD_MB=12
IDENTIFY_RATE_LIMIT_PER_MINUTE=10
# Product decision: user photos are NOT stored unless this is true AND the user
# explicitly consents for that request.
ALLOW_USER_IMAGE_STORAGE=false
# Salt used to hash the anonymous device id before storing it (required in production).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLIENT_HASH_SALT=
