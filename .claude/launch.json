{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DEMO_MODE=true",
        "backend/.venv/bin/uvicorn",
        "--app-dir",
        "backend",
        "app.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "--app-dir",
        "backend",
        "app.main:create_app",
        "--factory",
        "--reload",
        "--reload-dir",
        "backend/app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
